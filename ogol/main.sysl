// Ogol on the original Raspberry Pi Pico W, over the USB serial port.
//
// **This is the desktop console with its first few lines swapped**, and nothing else. The
// read-run-print loop is `sh.sysl.ogol.session`, so what is left here is the only platform-dependent
// part: which streams the lines come from, and that the board has to be started first.

import sh.sysl.pico.*
import sh.sysl.ogol.*
import sysl.term.edit.editor

@export("main")
boot() -> int =
    if !init()
        print("the board did not start")
        return 1

    // A board prints into nowhere until a host attaches, because the SDK discards stdio output with
    // no reader — so the banner is written after this and not before.
    wait_for_terminal()

    print("Ogol on a Raspberry Pi Pico W. Type a line, or 'bye' to leave.")
    print("")

    var input = console_in()
    var output = console_out()
    var ed = editor(&input, &output)
    var interp = ogol()

    session(interp, &ed)

    0
end boot
